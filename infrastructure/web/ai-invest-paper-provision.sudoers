# V0 single-host PAPER onboarding infrastructure. No generic privilege grant.
Cmnd_Alias AI_INVEST_PAPER_PROVISION = sha256:82f91e8f370442a6aeeedff3552c7c295516c5eb2760a1875b6c3fa8c8887d79 /usr/local/sbin/ai-invest-paper-provision ""
Defaults!AI_INVEST_PAPER_PROVISION !use_pty,authenticate,timestamp_timeout=0,!exempt_group
Defaults!AI_INVEST_PAPER_PROVISION env_reset,!env_keep,!env_check,!setenv,always_set_home,set_logname,secure_path="/usr/sbin:/usr/bin:/sbin:/bin"
Defaults!AI_INVEST_PAPER_PROVISION closefrom=3,!closefrom_override,umask=0077,fdexec=never
Defaults!AI_INVEST_PAPER_PROVISION !log_input,!log_output,!log_stdin,!log_stdout,!log_stderr,!log_ttyin,!log_ttyout
#1000 ALL=(root:root) PASSWD: NOSETENV: AI_INVEST_PAPER_PROVISION
